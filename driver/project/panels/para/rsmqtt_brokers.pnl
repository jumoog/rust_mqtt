"#uses \"rsmqtt\"

main()
{
  // an existing broker was picked (typing a new name keeps the form)
  if ( dynContains(this.items, this.text) > 0 )
    rsmqttPanelShow(this.text);
  else
    rsmqttPanelUpdateState();
}" 0

